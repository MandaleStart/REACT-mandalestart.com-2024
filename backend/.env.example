PORT=4000
NODE_ENV=development
TRUST_PROXY_HOPS=0
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173,https://dev.mandalestart.com,https://mandalestart.com,https://www.mandalestart.com

# PostgreSQL stores client records, projects, contracted services, and the public catalog.
# Use a local PostgreSQL administrator connection only for npm run db:create.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5433/postgres
DATABASE_NAME=mandalestart
# Application connection used by the API and npm run db:migrate.
DATABASE_URL=postgresql://user:password@localhost:5433/mandalestart
PG_POOL_MAX=5

# Firebase Admin: configure either a service account JSON path or workload identity.
# Firebase Authentication remains the identity provider; Admin verifies its ID tokens.
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/web-mandalestart-firebase-adminsdk-fbsvc-9b8d06eecf.json
# FIREBASE_PROJECT_ID=your-firebase-project-id

# SMTP settings are required for POST /api/contact.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
CONTACT_TO=info@mandalestart.com

# Public website contact details. Leave both phone variables empty to hide phone/WhatsApp links.
PUBLIC_CONTACT_EMAIL=info@mandalestart.com
PUBLIC_CONTACT_PHONE_E164=
PUBLIC_CONTACT_PHONE_DISPLAY=
