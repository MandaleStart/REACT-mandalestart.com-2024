{
  "name": "mandalestart-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio y landing page de servicios web desarrollada con React y Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/generate-route-pages.js",
    "preview": "vite preview --host",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test",
    "test:e2e": "playwright test",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.js\" \"docs/**/*.md\" .prettierrc.json vite.config.js index.html package.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.js\" \"docs/**/*.md\" .prettierrc.json vite.config.js index.html package.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vercel/speed-insights": "^1.0.9",
    "firebase": "^12.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^14.0.0",
    "prettier": "^3.9.10",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}